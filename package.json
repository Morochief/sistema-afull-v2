    "drizzle-orm": "^0.36.4",
    "eslint": "^9.14.0",
    "postgres": "^3.4.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
